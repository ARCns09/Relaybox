NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
API_PORT=8787

MAIL_DOMAINS=relaybox.ryzn.pro
DATABASE_URL=./data/mail.db
DEFAULT_MAILBOX_LIFETIME=86400
MAX_MAILBOX_STORAGE_MB=25
MAX_MESSAGE_SIZE_MB=10
MAX_ATTACHMENT_SIZE_MB=5
BLOCK_REMOTE_IMAGES=true
ALLOW_DELETIONS=true

MAIL_PROVIDER=development
RESEND_API_KEY=
RESEND_INBOUND_ENABLED=true
RESEND_SYNC_INTERVAL_SECONDS=10
OUTBOUND_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

ATTACHMENT_STORAGE=local
ATTACHMENT_STORAGE_PATH=./storage/attachments
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
